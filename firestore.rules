rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn()  {
      return request.auth != null
          && request.auth.token.role in ['admin', 'tecnico'];
    }
    function isAdmin()   { return signedIn() && request.auth.token.role == 'admin'; }
    function isTecnico() { return signedIn() && request.auth.token.role == 'tecnico'; }
    function locked(d)   { return d.status == 'completo' || d.status == 'firmado'; }

    // #19 — El admin puede reabrir un doc bloqueado, pero SOLO como transición
    // exacta a en_progreso tocando nada más que estos campos (no reedita
    // contenido bloqueado en el mismo write).
    //
    // #P0-3 — El acta de conformidad FIRMADA queda fuera: la firma del cliente
    // es el único acto con valor probatorio del protocolo y en esta versión es
    // irreversible (firmado = definitivo). Los demás documentos conservan la
    // reapertura, porque para ellos es un circuito previsto y necesario: una RF
    // firmada como NO apta se corrige reabriéndola.
    function isReopen(before, after, docType) {
      return locked(before)
          && !(docType == 'AC' && before.status == 'firmado')
          && after.status == 'en_progreso'
          && after.updatedBy == request.auth.uid
          && after.reopenedBy == request.auth.uid
          && after.updatedAt is int
          && after.reopenedAt is int
          && after.updatedAt >= before.updatedAt
          && after.lockedSnapshot == null
          && after.lockedAt == null
          && after.lockedBy == null
          && after.version == before.version + 1
          && after.diff(before).affectedKeys().hasOnly([
               'status', 'updatedAt', 'updatedBy', 'reopenedAt', 'reopenedBy',
               'lockedSnapshot', 'lockedAt', 'lockedBy', 'version'
             ]);
    }

    // #P0-3/#P0-4 — El acta solo se firma con una firma del cliente REAL.
    //
    // Sin la condición de `pending`, se podía firmar un acta cuya firma todavía
    // estaba en la cola offline: una vez bloqueado el documento las reglas
    // rechazan el `updateDoc` de `flushPhotoQueue()`, así que la referencia
    // pendiente queda congelada para siempre y el acta se imprime sin firma.
    //
    // Sin la condición de path, un escritor directo podía apuntar la firma a un
    // objeto guardado bajo OTRO docType del mismo proyecto (por ejemplo
    // projects/<code>/FM/x.jpg). Ese documento sigue abierto, así que las
    // Storage Rules dejarían sobrescribir el JPEG después de firmar: el
    // lockedSnapshot seguiría apuntando al mismo path con otra imagen detrás.
    //
    // Solo se evalúa en la transición a 'firmado'; después el acta es inmutable.
    function firmaClienteSubida(code, after, docType) {
      return !(docType == 'AC' && after.status == 'firmado')
          || (after.firmaCliente.firma is map
              && after.firmaCliente.firma.get('pending', false) != true
              && after.firmaCliente.firma.storagePath is string
              && after.firmaCliente.firma.storagePath.split('/').size() == 4
              && after.firmaCliente.firma.storagePath.split('/')[0] == 'projects'
              && after.firmaCliente.firma.storagePath.split('/')[1] == code
              && after.firmaCliente.firma.storagePath.split('/')[2] == 'AC');
    }

    function validDocIdentity(before, after, code, docType) {
      return before.docType == docType
          && after.docType == docType
          && before.projectCode == code
          && after.projectCode == code
          && after.createdAt == before.createdAt;
    }

    function validNormalDocUpdate(before, after) {
      return !locked(before)
          && after.status in ['vacio', 'en_progreso', 'completo', 'firmado']
          && after.updatedBy == request.auth.uid
          && after.updatedAt is int
          && before.updatedAt is int
          && after.updatedAt >= before.updatedAt
          && before.version is int
          && after.version is int
          && ((locked(after)
                && after.version == before.version + 1
                && after.lockedSnapshot is map
                && after.lockedAt is int
                && after.lockedBy == request.auth.uid)
              || (!locked(after)
                && after.version == before.version
                && after.lockedSnapshot == before.lockedSnapshot
                && after.lockedAt == before.lockedAt
                && after.lockedBy == before.lockedBy));
    }

    // #7 — Valida que todos los valores del mapa docStatus estén en el enum.
    // Los 6 docTypes siempre existen (initEmptyDocs los inicializa al crear el proyecto).
    function validDocStatusMap(ds) {
      return ds.VT in ['vacio','en_progreso','completo','firmado']
          && ds.EP in ['vacio','en_progreso','completo','firmado']
          && ds.OT in ['vacio','en_progreso','completo','firmado']
          && ds.RF in ['vacio','en_progreso','completo','firmado']
          && ds.AC in ['vacio','en_progreso','completo','firmado']
          && ds.FM in ['vacio','en_progreso','completo','firmado'];
    }

    // #7 — El técnico solo puede avanzar el estado del proyecto, nunca
    // retroceder ni saltear pasos (borrador → en_curso → entregado).
    function validProjectStatusTransition(current, next) {
      return (current == 'borrador'  && next in ['borrador', 'en_curso'])
          || (current == 'en_curso'  && next in ['en_curso', 'entregado'])
          || (current == 'entregado' && next == 'entregado');
    }

    // #7 — No permite marcar el proyecto como 'entregado' si el AC no está
    // firmado. Costo: 1 lectura extra por escritura; aceptable para uso interno.
    function acEstaFirmado(code) {
      return get(/databases/$(db)/documents/projects/$(code)/documents/AC)
               .data.status == 'firmado';
    }

    // #21 — Documento anterior en el protocolo VT→EP→OT→RF→AC→FM.
    function prevDocType(dt) {
      return dt == 'EP' ? 'VT'
           : dt == 'OT' ? 'EP'
           : dt == 'RF' ? 'OT'
           : dt == 'AC' ? 'RF'
           : dt == 'FM' ? 'AC'
           : '';   // VT no tiene anterior.
    }
    function docCerrado(code, dt) {
      return get(/databases/$(db)/documents/projects/$(code)/documents/$(dt))
               .data.status in ['completo','firmado'];
    }
    function rfApto(code) {
      return get(/databases/$(db)/documents/projects/$(code)/documents/RF)
               .data.aptoEntrega == true;
    }
    // Un proyecto archivado es de solo lectura: ninguna escritura en sus
    // documentos (para editar hay que desarchivarlo primero). Cuesta 1 lectura
    // por escritura de documento; aceptable para uso interno.
    function projectArchived(code) {
      return get(/databases/$(db)/documents/projects/$(code))
               .data.status == 'archivado';
    }

    // #21 — Un documento solo se cierra (completo/firmado) si el anterior del
    // protocolo ya está cerrado; el acta (AC) además exige RF apto para entrega.
    // Solo cuesta lecturas extra al cerrar, no en cada autosave.
    function secuenciaOk(code, docType, newStatus) {
      return !(newStatus in ['completo','firmado'])
          || ((docType == 'VT' || docCerrado(code, prevDocType(docType)))
              && (docType != 'AC' || rfApto(code)));
    }

    match /clients/{clientId} {
      allow read:   if signedIn();
      allow create: if false;  // solo Admin SDK crea clientes
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /users/{uid} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    match /counters/{year} {
      // Solo escribe el Admin SDK (creación/duplicación de proyectos).
      allow read:  if signedIn();
      allow write: if false;
    }

    match /config/{document} {
      allow read:  if signedIn();   // los forms lo leen para sembrar
      allow write: if isAdmin();    // solo admin edita el protocolo
    }

    match /signRequests/{token} {
      // Solicitudes de firma remota del acta: solo el Admin SDK (/api/sign)
      // las lee y escribe. Ningún cliente —ni admin— accede directo: el token
      // es la credencial del link público y no debe poder enumerarse.
      allow read, write: if false;
    }

    match /projects/{code} {
      allow read:   if signedIn();
      allow create: if isAdmin();
      allow update: if (isAdmin()
                        // #11 — Congela createdAt/createdBy: ningún update los puede mutar.
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.createdBy == resource.data.createdBy)
                    || (isTecnico()
                          // Solo puede tocar estos cuatro campos.
                          && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['docStatus','status','updatedAt','updatedBy'])
                          // #11 — updatedBy debe ser el uid del técnico que escribe.
                          && request.resource.data.updatedBy == request.auth.uid
                          // status del proyecto debe ser un valor del enum.
                          && request.resource.data.status in ['borrador','en_curso','entregado']
                          // Sin saltos ni retrocesos en el flujo.
                          && validProjectStatusTransition(
                               resource.data.status,
                               request.resource.data.status)
                          // Cada slot de docStatus debe tener un valor del enum.
                          && validDocStatusMap(request.resource.data.docStatus)
                          // No puede marcar entregado si el AC no está firmado.
                          && (request.resource.data.status != 'entregado'
                               || acEstaFirmado(code)));
      allow delete: if isAdmin();

      match /documents/{docType} {
        allow read: if signedIn();
        // Admin: acceso a los 6 documentos, pero no puede mutar un doc ya bloqueado.
        // Técnico: solo VT, EP, OT, RF.
        // (#5 reglas) AC y FM son exclusivos del admin, coherente con el
        //             guard de UI en ACForm (Batch 3).
        // Los documentos base nacen por Admin SDK. El cliente solo actualiza
        // documentos existentes; no puede crear IDs alternativos ni borrarlos.
        allow create, delete: if false;
        allow update: if !projectArchived(code)
                      && validDocIdentity(resource.data, request.resource.data, code, docType)
                      && firmaClienteSubida(code, request.resource.data, docType)
                      && ((isAdmin()
                           && (isReopen(resource.data, request.resource.data, docType)
                               || (validNormalDocUpdate(resource.data, request.resource.data)
                                   && secuenciaOk(code, docType,
                                                  request.resource.data.status))))
                          || (isTecnico()
                           && docType in ['VT', 'EP', 'OT', 'RF']
                           && validNormalDocUpdate(resource.data, request.resource.data)
                           && secuenciaOk(code, docType, request.resource.data.status)));
      }

      match /revisions/{rev} {
        allow read:           if signedIn();
        // #10 — by debe ser el uid del autor; at debe ser el timestamp del servidor.
        allow create:         if signedIn()
                                 && request.resource.data.keys().hasAll([
                                      'docType', 'projectCode', 'action', 'snapshot',
                                      'version', 'by', 'at'
                                    ])
                                 && request.resource.data.keys().hasOnly([
                                      'docType', 'projectCode', 'action', 'snapshot',
                                      'version', 'by', 'at'
                                    ])
                                 && request.resource.data.docType in ['VT','EP','OT','RF','AC','FM']
                                 && request.resource.data.projectCode == code
                                 && request.resource.data.action in ['vacio','en_progreso','completo','firmado']
                                 && request.resource.data.snapshot is map
                                 && request.resource.data.version is int
                                 && request.resource.data.version >= 0
                                 && request.resource.data.by == request.auth.uid
                                 && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }
  }
}
